# ============================================================================
# ARQUIVO DE PRODUCAO PARA A VPS (.env)
# Copie para a VPS:  cp .env.production.example .env   e edite os valores
# ============================================================================

# ---------------------------------------------------------------------------
# BANCO DE DADOS
# Por padrao o deploy usa o Postgres LOCAL que sobe junto no docker-compose
# (servico "postgres"). Para usar o Supabase, troque as duas linhas abaixo
# pela connection string do Supabase (use o pooler IPv4 em VPS sem IPv6).
#   Local (padrao):  postgresql://postgres:SUA_SENHA@postgres:5432/ai_saas
#   Supabase pooler: postgresql://postgres.<ref>:SENHA@aws-0-<regiao>.pooler.supabase.com:5432/postgres
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:changeme@postgres:5432/ai_saas

# ---------------------------------------------------------------------------
# REDIS (usado pelo Celery - fila de execucao)
# Se o Redis do docker-compose estiver em uso, mantenha o valor abaixo.
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# SECRET_KEY -> CHAVE DE ASSINATURA DO JWT (seguranca na autenticacao)
# Responsavel por assinar os tokens de login. Se trocar depois, usuarios
# serao deslogados. GERE UMA NOVA e segura na VPS:
#   openssl rand -hex 32
# Este valor NAO e o do ambiente de desenvolvimento local.
# ---------------------------------------------------------------------------
SECRET_KEY=GERE_COM_OPENSLL_RAND_HEX_32

# ---------------------------------------------------------------------------
# SECRET_ENCRYPTION_KEY -> CHAVE DE CRIPTOGRAFIA DOS CAMPOS SENSIVEIS
# Usada para criptografar as chaves IA/Evolution de cada empresa (Fernet).
# NAO MUDE DEPOIS de salvar dados criptografados, ou nao conseguira ler.
# Se deixar vazio, deriva de SECRET_KEY. Gere com:  openssl rand -hex 32
# ---------------------------------------------------------------------------
SECRET_ENCRYPTION_KEY=GERE_COM_OPENSLL_RAND_HEX_32

# ---------------------------------------------------------------------------
# IA PADRAO (Groq - usada por empresas sem config propria)
# ---------------------------------------------------------------------------
DEFAULT_AI_PROVIDER=groq
DEFAULT_AI_MODEL=qwen/qwen3.8-27b
DEFAULT_AI_API_KEY=SUA_CHAVE_GROQ_AQUI

# ---------------------------------------------------------------------------
# EVOLUTION API (WhatsApp)
# EVOLUTION_BASE_URL: dentro do docker-compose usa o nome do servico "evolution"
# Se a Evolution rodar em outro lugar, ajuste a URL.
# EVOLUTION_AUTH_KEY: chave injetada pelo docker-compose.evolution.yml como
#   AUTHENTICATION_API_KEY da Evolution (v2.3.x = a que VOCE define; 2.4.0+ =
#   api_key da ativacao de licenca). O compose nao usa env_file, entao esta
#   variavel e OBRIGATORIA p/ a Evolution subir.
# EVOLUTION_API_KEY: a MESMA chave, usada pelo backend (app/services/evolution.py)
#   para autenticar. NAO use a chave da Groq.
# Gere com: openssl rand -hex 32
# ---------------------------------------------------------------------------
EVOLUTION_BASE_URL=http://evolution:8080
EVOLUTION_AUTH_KEY=GERE_COM_OPENSLL_RAND_HEX_32
EVOLUTION_API_KEY=GERE_COM_OPENSLL_RAND_HEX_32
EVOLUTION_INSTANCE=flowai
# URL publica usada pela Evolution para gerar o QR e callbacks. Deve ser o IP/publico + porta 8080.
EVOLUTION_SERVER_URL=http://SEU_IP_PUBLICO:8080
# Banco da Evolution (opcional). O docker-compose.evolution.yml monta a
# DATABASE_CONNECTION_URI com POSTGRES_PASSWORD apontando para o banco "evolution"
# (separado do "ai_saas" da aplicacao). Mantenha vazio nesta variavel; a URI e
# montada pelo compose usando POSTGRES_PASSWORD.
EVOLUTION_DATABASE_URI=

# ---------------------------------------------------------------------------
# POSTGRES_PASSWORD: so e usada se voce optar pelo Postgres local do Docker.
# Pode ignorar quando usar o Supabase.
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=changeme
