# ============================================================================
# ARQUIVO DE PRODUCAO PARA A VPS (.env)
# Copie para a VPS:  cp .env.production.example .env   e edite os valores
# ============================================================================

# ---------------------------------------------------------------------------
# BANCO DE DADOS (producao = SUPABASE, regra inegociavel — ver AGENTS.md §7)
# Use o pooler IPv4 em VPS sem IPv6. O Postgres local do docker-compose e
# apenas alternativa/fallback, NUNCA o banco em uso em producao.
#   Supabase pooler: postgresql://postgres.<ref>:SENHA@aws-0-<regiao>.pooler.supabase.com:5432/postgres
#   Local (fallback):  postgresql://postgres:SUA_SENHA@postgres:5432/ai_saas
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.<ref>:SENHA@aws-0-<regiao>.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# REDIS (usado pelo Celery - fila de execucao)
# Se o Redis do docker-compose estiver em uso, mantenha o valor abaixo.
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# SECRET_KEY -> CHAVE DE ASSINATURA DO JWT (seguranca na autenticacao)
# Responsavel por assinar os tokens de login. Se trocar depois, usuarios
# serao deslogados. GERE UMA NOVA e segura na VPS:
#   openssl rand -hex 32
# Este valor NAO e o do ambiente de desenvolvimento local.
# ---------------------------------------------------------------------------
SECRET_KEY=GERE_COM_OPENSLL_RAND_HEX_32

# ---------------------------------------------------------------------------
# CORS -> origens permitidas (lista separada por virgula)
# Use o dominio real de producao. Ex.: https://app.minhaempresa.com
# IMPORTANTE: NUNCA habilite o seed em producao.
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS=https://SEU_DOMINIO_AQUI

# ---------------------------------------------------------------------------
# SECRET_ENCRYPTION_KEY -> CHAVE DE CRIPTOGRAFIA DOS CAMPOS SENSIVEIS
# Usada para criptografar as chaves IA/Evolution de cada empresa (Fernet).
# NAO MUDE DEPOIS de salvar dados criptografados, ou nao conseguira ler.
# Se deixar vazio, deriva de SECRET_KEY. Gere com:  openssl rand -hex 32
# ---------------------------------------------------------------------------
SECRET_ENCRYPTION_KEY=GERE_COM_OPENSLL_RAND_HEX_32

# ---------------------------------------------------------------------------
# IA PADRAO (Groq - usada por empresas sem config propria)
# ---------------------------------------------------------------------------
DEFAULT_AI_PROVIDER=groq
DEFAULT_AI_MODEL=qwen/qwen3.8-27b
DEFAULT_AI_API_KEY=SUA_CHAVE_GROQ_AQUI

# ---------------------------------------------------------------------------
# EVOLUTION API (WhatsApp)
# EVOLUTION_BASE_URL: dentro do docker-compose usa o nome do servico "evolution"
# Se a Evolution rodar em outro lugar, ajuste a URL.
# EVOLUTION_AUTH_KEY: chave injetada pelo docker-compose.evolution.yml como
#   AUTHENTICATION_API_KEY da Evolution (v2.3.x = a que VOCE define; 2.4.0+ =
#   api_key da ativacao de licenca). O compose nao usa env_file, entao esta
#   variavel e OBRIGATORIA p/ a Evolution subir.
# EVOLUTION_API_KEY: OBRIGATORIAMENTE A MESMA de EVOLUTION_AUTH_KEY. Usada pelo
#   backend (app/services/evolution.py) para autenticar. Se divergirem, o setup
#   retorna 401 Unauthorized. NAO use a chave da Groq.
# EVOLUTION_INSTANCE: fallback global de instancia. O padrao por empresa e
#   automatico (`inst-<company_id>`, sem config manual). So defina aqui se
#   quiser forcar uma instancia unica (cenario de 1 empresa).
# Gere as chaves com: openssl rand -hex 32
# ---------------------------------------------------------------------------
EVOLUTION_BASE_URL=http://evolution:8080
EVOLUTION_AUTH_KEY=GERE_COM_OPENSLL_RAND_HEX_32
EVOLUTION_API_KEY=GERE_COM_OPENSLL_RAND_HEX_32
# EVOLUTION_INSTANCE=flowai
# Banco operacional da Evolution (futuro/escala): o default do compose e o
# postgres local (exigido no startup). Para migrar p/ Supabase (plano Pro):
# EVOLUTION_DATABASE_CONNECTION_URI=postgresql://<user>:<pass>@aws-0-<regiao>.pooler.supabase.com:5432/evolution
# NOTA: NAO crie EVOLUTION_SERVER_URL — nao e lida por codigo. O
# docker-compose.evolution.yml define SERVER_URL no proprio arquivo.

# ---------------------------------------------------------------------------
# POSTGRES_PASSWORD: senha do Postgres local do Docker. E usada na inicializacao
# do servico "postgres" E pela Evolution (banco operacional
# postgres:5432/evolution via docker-compose.evolution.yml). NAO ignore mesmo
# usando Supabase no app — sem ela a Evolution cai em crash-loop (P1000).
# Se o postgres ja foi criado com outra senha, alinhe via:
#   docker compose exec postgres psql -U postgres -c "ALTER USER postgres WITH PASSWORD '<valor>';"
# Depois recrie os containers com --force-recreate (restart NAO reaplica env).
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=changeme
