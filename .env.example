# ============================================================================
# ARQUIVO DE DESENVOLVIMENTO LOCAL (.env)
# Copie para:  cp .env.example .env   e edite os valores
# Em dev local, por padrao usa SQLite (sem precisar de Postgres instalado).
# ============================================================================

# Database
# Dev local (SQLite - sem setup):
DATABASE_URL=sqlite:///./aissaas.db
# Producao/local com Postgres:
# DATABASE_URL=postgresql://postgres:changeme@localhost:5432/ai_saas
POSTGRES_PASSWORD=changeme

# Redis (Celery broker)
REDIS_URL=redis://localhost:6379/0

# Security
# OBRIGATORIA - sem ela o servidor NAO inicia.
SECRET_KEY=changeme-in-production-generate-with-openssl-rand-hex-32

# Chave para criptografar campos sensiveis (chaves IA/Evolution das empresas).
# Se vazio, deriva de SECRET_KEY. NUNCA altere depois de salvar dados criptografados.
# Gere com: openssl rand -hex 32
SECRET_ENCRYPTION_KEY=changeme-generate-with-openssl-rand-hex-32

# CORS - origens permitidas (lista separada por virgula). Em producao, use o dominio real.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seed de usuario de teste (SOMENTE desenvolvimento local).
# NAO habilite em producao. Roda apenas se o banco estiver vazio.
SEED_DEFAULT_USER=true
SEED_USER_EMAIL=teste@flowai.com
SEED_USER_PASSWORD=teste123
SEED_USER_NAME=Usuario Teste
SEED_COMPANY_NAME=Empresa Teste

# AI Defaults (herdados por empresas sem config propria)
DEFAULT_AI_PROVIDER=groq
DEFAULT_AI_MODEL=qwen/qwen3.8-27b
DEFAULT_AI_API_KEY=your-groq-key-here

# Evolution API (WhatsApp)
# EVOLUTION_AUTH_KEY e EVOLUTION_API_KEY devem ter O MESMO valor (senao 401).
EVOLUTION_BASE_URL=http://evolution:8080
EVOLUTION_API_KEY=your-evolution-key
EVOLUTION_AUTH_KEY=your-evolution-key
# Instancia por empresa e automatica (inst-<company_id>). EVOLUTION_INSTANCE
# abaixo e so fallback global (cenario de 1 empresa).
# EVOLUTION_INSTANCE=flowai
# Banco operacional da Evolution (futuro/escala; default do compose = postgres local):
# EVOLUTION_DATABASE_CONNECTION_URI=postgresql://postgres:changeme@postgres:5432/evolution
